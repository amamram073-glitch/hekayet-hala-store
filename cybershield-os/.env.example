# Copy to .env and replace all placeholders; never commit .env.
DATABASE_URL=postgresql+psycopg://cybershield:replace_me@postgres:5432/cybershield
REDIS_URL=redis://:replace_with_redis_password@redis:6379/0
REDIS_PASSWORD=replace_with_long_random_password
JWT_SECRET=replace-with-at-least-32-cryptographically-random-bytes
SESSION_SECRET=reserved-for-future-session-key-rotation
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
APP_URL=http://localhost:8080
ENVIRONMENT=development
COOKIE_SECURE=false
REPORT_DIR=/var/lib/cybershield/reports
SCAN_TIMEOUT_SECONDS=4
POSTGRES_DB=cybershield
POSTGRES_USER=cybershield
POSTGRES_PASSWORD=replace_me
HTTP_PORT=8080
